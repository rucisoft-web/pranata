# Pengaman bila document root domain salah diarahkan ke folder program (seharusnya ke public/).
# Blokir file sensitif dan teruskan semua permintaan ke public/.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<FilesMatch "^(\.env.*|artisan|composer\.(json|lock)|.*\.md|phpunit\.xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
