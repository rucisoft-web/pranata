APP_NAME=PRANATA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pranata.domainanda.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pranata
DB_USERNAME=pranata
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

# MFA (aplikasi authenticator) wajib untuk semua akun. false = pilihan per pengguna.
PRANATA_MFA_REQUIRED=true
# Data contoh tiga perusahaan DEMO dimuat saat `php artisan migrate --seed`. Biarkan false untuk pemakaian sungguhan.
PRANATA_SEED_DEMO=false
# Situs demo/promosi: tombol "Masuk sebagai Tamu" dan halaman /demo (hanya baca data contoh).
PRANATA_GUEST_LOGIN=false
